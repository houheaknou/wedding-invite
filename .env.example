# Database container (docker-compose.yml, docker-compose.prod.yml). Used only when the data volume is
# first created — keep DATABASE_URL below in step. Use a long random password outside local dev.
POSTGRES_USER="wedding"
POSTGRES_PASSWORD="wedding"
POSTGRES_DB="wedding_invite"

# Local dev database (see docker-compose.yml)
DATABASE_URL="postgresql://wedding:wedding@localhost:5434/wedding_invite?schema=public"

# Public address used in invitation links shared to guests (Telegram, copy link).
# Leave empty locally; set to your domain in production. To test on phones on the same Wi-Fi,
# use this computer's LAN address, e.g. http://192.168.0.53:3000
NEXT_PUBLIC_APP_URL=""

# --- Sign in with Google (optional; the button only shows when both are set) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → "Web application".
# Authorised redirect URI: <app address>/api/auth/google/callback, e.g.
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Sign in with Telegram (optional; the button only shows when both are set) ---
# @BotFather → /newbot gives the token and username; then /setdomain → your public domain
# (Telegram's widget does not work on localhost).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
