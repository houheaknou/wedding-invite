# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# What goes into the Docker image is decided separately by .dockerignore.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output (dev server: .next, tester server: .next-prod)
/.next/
/.next-prod/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# secrets: real keys live only in .env on each machine/server; .env.example is the template
.env*
!.env.example
*.pem

# user data: uploaded music (production keeps it in a Docker volume)
/uploads/

# logs (dev/tester server output, npm/yarn debug logs)
*.log

# third-party design screenshots, kept locally for reference only (not ours to publish)
/docs/design-refs/

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# vercel
.vercel
